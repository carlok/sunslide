{
  "name": "sunslide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "3D sliding-island arcade puzzle on a tiny planet (three.js, Vite).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "vitest run --coverage",
    "test:smoke": "node tests/smoke.mjs",
    "lint": "eslint src/logic tests scripts",
    "hero": "node scripts/capture-hero.mjs",
    "audit:quality": "node scripts/quality-audit.mjs",
    "lhci": "lhci autorun && lhci autorun --config=lighthouserc-desktop.cjs"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "html-validate": "^11.21.1",
    "lighthouse": "^13.6.0",
    "playwright": "^1.49.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "@lhci/cli": "^0.14.0",
    "chrome-launcher": "^1.1.2"
  }
}
